# Copy to .env (git-ignored) and load with your process manager or `set -a; . ./.env`.
# Generate strong values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# API keys (role-based). If unset, random keys are generated and printed at startup.
AEGIS_ANALYST_KEY=
AEGIS_VIEWER_KEY=

# Secret used to verify models/aegis.model.sig. Retrain with the same value set.
AEGIS_MODEL_KEY=

# Secret for the audit hash chain. Changing it makes existing logs fail verification.
AEGIS_AUDIT_KEY=

# Optional: enables the Claude investigator (otherwise the deterministic one is used).
ANTHROPIC_API_KEY=
# AEGIS_LLM_MODEL=claude-opus-5-5
# AEGIS_LLM_EFFORT=high

# Demo stream rate in transactions/second (0 disables).
AEGIS_DEMO_RATE=20
